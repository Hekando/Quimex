-- =====================================================
-- SE GENERA UNA VISTA SIMPLE POR ASISTENCIA ACENDENTE
-- =====================================================
-- Eliminar la vista si ya existía para evitar errores
DROP VIEW IF EXISTS vista_resumen_asistencias;

-- Crear la vista
CREATE VIEW vista_resumen_asistencias AS
SELECT
    u.id_usuario,
    u.nombre,
    r.nombre_rol,
    COUNT(a.id_asistencia) AS dias_asistidos
FROM usuarios u
INNER JOIN roles r ON u.id_rol = r.id_roles
LEFT JOIN asistencias a ON u.id_usuario = a.id_usuario
GROUP BY u.id_usuario, u.nombre, r.nombre_rol;

-- =====================================================
-- SE GENERA PROCEDIMIENTO CONSULTA EN BASE ENTRADA "NOMBRE"
-- =====================================================
-- Eliminar el procedimiento si ya existía para evitar duplicados
DROP PROCEDURE IF EXISTS ConsultarAsistenciaPorNombre;

DELIMITER $$

CREATE PROCEDURE ConsultarAsistenciaPorNombre(
    IN p_nombre VARCHAR(50) -- Variable de entrada para el nombre del usuario
)
BEGIN
    SELECT
        u.nombre,
        r.nombre_rol,
        COUNT(a.id_asistencia) AS dias_asistidos
    FROM usuarios u
    INNER JOIN roles r ON u.id_rol = r.id_roles
    LEFT JOIN asistencias a ON u.id_usuario = a.id_usuario
    WHERE u.nombre LIKE CONCAT('%', p_nombre, '%') -- Filtra coincidencias parciales
    GROUP BY u.id_usuario, u.nombre, r.nombre_rol;
END$$

DELIMITER ;